# Copy to .env (git-ignored) and fill in. Never commit .env.

# Tinker (scripts/rollout.py and scripts/train.py without --dry-run)
TINKER_API_KEY=

# Snowflake (only for --destination snowflake). Key-pair auth, no password.
SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
SNOWFLAKE_USER=ELT_RL_USER
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/elt_rl_key.p8
SNOWFLAKE_ROLE=ELT_RL_ROLE
SNOWFLAKE_WAREHOUSE=ELT_RL_WH
